{
    "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["**", "!!**/node_modules", "!!**/dist", "!!**/public", "!!**/syntax-ts", "!!**/coverage"]
    },
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentWidth": 4,
        "indentStyle": "space",
        "lineWidth": 120,
        "includes": ["**", "!**/node_modules/**", "!**/dist/**", "!**/public/**", "!**/syntax-ts/**", "!**/coverage/**"]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "useImportType": "off",
                "useNodejsImportProtocol": "off"
            },
            "complexity": {
                "noForEach": "off",
                "noBannedTypes": "off"
            },
            "suspicious": {
                "noExplicitAny": "off",
                "noThenProperty": "off",
                "noArrayIndexKey": "off"
            },
            "a11y": {
                "useKeyWithClickEvents": "off"
            },
            "correctness": {
                "useExhaustiveDependencies": "off"
            }
        },
        "includes": ["**", "!**/node_modules/**", "!**/dist/**", "!**/public/**", "!**/syntax-ts/**", "!**/coverage/**"]
    },
    "overrides": [
        {
            "includes": ["**/*.test.ts", "**/*.test.tsx"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noComponentHookFactories": "off"
                    }
                }
            }
        }
    ],
    "javascript": {
        "parser": {
            "unsafeParameterDecoratorsEnabled": true
        },
        "formatter": {
            "enabled": true,
            "indentStyle": "space",
            "indentWidth": 4,
            "lineWidth": 180,
            "arrowParentheses": "asNeeded",
            "trailingCommas": "none",
            "quoteStyle": "single",
            "semicolons": "asNeeded"
        }
    },
    "json": {
        "formatter": {
            "enabled": true,
            "indentStyle": "space",
            "indentWidth": 4,
            "lineWidth": 180
        },
        "parser": {
            "allowComments": true
        }
    }
}
